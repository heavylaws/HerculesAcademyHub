# PeakForm Athletics (Hercules Academy) - Environment Configuration

# ==============================================================================
# Frontend Environment Variables (Vite)
# Prefix with VITE_ to expose to the client browser bundle
# ==============================================================================

# Convex Deployment URL
# For local dev via `npx convex dev`, this is set automatically or defaults to http://localhost:3000
VITE_CONVEX_URL=http://localhost:3000

# Hercules Auth (OIDC)
VITE_HERCULES_OIDC_AUTHORITY=https://01m1maqj19rrqvx7arxzrp6hdc.hercules-auth.com
VITE_HERCULES_OIDC_CLIENT_ID=01M1MAQJ35TDC0XSZFK4F5FCFQ
VITE_HERCULES_OIDC_PROMPT=select_account
VITE_HERCULES_OIDC_RESPONSE_TYPE=code
VITE_HERCULES_OIDC_SCOPE=openid profile email offline_access

# Hercules Website / App ID for assets & analytics
VITE_HERCULES_WEBSITE_ID=peakform-athletics

# Optional custom redirect URI (defaults to /auth/callback on current origin)
# VITE_HERCULES_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# ==============================================================================
# Convex Backend Environment Variables
# Set these in your Convex deployment via `npx convex env set <NAME> <VALUE>`
# ==============================================================================

# Hercules Auth validation in convex/auth.config.ts
HERCULES_OIDC_AUTHORITY=https://01m1maqj19rrqvx7arxzrp6hdc.hercules-auth.com
HERCULES_OIDC_CLIENT_ID=01M1MAQJ35TDC0XSZFK4F5FCFQ

# Hercules AI Gateway API Key (OpenAI video biomechanics analysis)
HERCULES_API_KEY=
