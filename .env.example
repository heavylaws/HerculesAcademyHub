# PeakForm Athletics (Hercules Academy) - Environment Configuration
# Copy to .env.local for local development. See docs/DEPLOYMENT.md for production.

# ==============================================================================
# Frontend (Vite) - embedded in the browser bundle at build time
# ==============================================================================

# true  = mock/demo mode: in-browser data + demo personas, NO real login.
# false = live mode: real Convex backend + email/password accounts.
# Deployed builds must be live (false).
VITE_LOCAL_DEV=true

# Convex deployment URL (printed by `npx convex dev` / `npx convex deploy`).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ==============================================================================
# Backend (Convex) - NOT read from this file. Set them in the Convex dashboard
# or with `npx convex env set [--prod] NAME value`.
# ==============================================================================
# SITE_URL=https://academy.example.com          # links in emails
# PLATFORM_ADMIN_EMAILS=you@example.com         # super admins (comma-separated)
# RESEND_API_KEY=re_...                         # email delivery (resend.com)
# EMAIL_FROM=PeakForm Athletics <no-reply@example.com>
# JWT_PRIVATE_KEY / JWKS                        # generated by `npx @convex-dev/auth`
# OPENAI_API_KEY=sk-...                         # video analysis (optional)
# OPENAI_VISION_MODEL=gpt-4o                    # optional
